# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly LF for source files
*.go     text eol=lf
*.ts     text eol=lf
*.svelte text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.sql    text eol=lf
*.sh     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.env    text eol=lf

# Binary — no line ending conversion
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
