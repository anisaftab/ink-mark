{
  "name": "Ink Mark Dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace/ink-mark",

  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.23"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": ["golang.go", "esbenp.prettier-vscode", "dbaeumer.vscode-eslint", "redhat.vscode-yaml", "saoudrizwan.claude-dev"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[go]": {
          "editor.defaultFormatter": "golang.go",
          "editor.formatOnSave": true
        },
        "go.toolsManagement.autoUpdate": true,
        "go.lintTool": "golangci-lint",
        "go.formatTool": "goimports",
        "tailwindCSS.includeLanguages": {
          "svelte": "html"
        },
        "tailwindCSS.experimental.classRegex": [
          ["clsx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"],
          ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
        ],
        "tailwindCSS.files.exclude": ["**/.git/**", "**/node_modules/**", "**/.hg/**", "**/backend/**"],
        "typescript.preferences.tsdk": "frontend/node_modules/typescript/lib"
      }
    }
  },

  "forwardPorts": [
    13000, // Svelte / Vite dev server  (inner: 3000)
    18080, // Go API server             (inner: 8080)
    15432 // PostgreSQL                (inner: 5432)
  ],

  "portsAttributes": {
    "13000": { "label": "Frontend (Vite)", "onAutoForward": "openBrowser", "host": "127.0.0.1" },
    "18080": { "label": "Backend API (Go)", "host": "127.0.0.1" },
    "15432": { "label": "PostgreSQL", "host": "127.0.0.1" }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "remoteUser": "vscode"
}
