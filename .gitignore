# Wails build output
/build/bin/releases/
/build/bin/ab/
/build/bin/tmp/
/build/bin/ink-mark-dev-linux-amd64

# Keep the versioned main exe tracked
!/build/bin/ink-mark.exe

# Go
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Frontend build output
/frontend/build/*
!/frontend/build/.gitkeep
/frontend/.svelte-kit/
/frontend/node_modules/

# Environment — commit .env and .env.dev, exclude local overrides
*.local

# OS
.DS_Store
Thumbs.db
