# Wails build output — ignore all binaries
/build/bin/

# Go
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Frontend build output
/frontend/build/*
!/frontend/build/.gitkeep
/frontend/.svelte-kit/
/frontend/node_modules/

# SQLite database files
*.db
*.db-shm
*.db-wal

# Environment — commit .env and .env.dev, exclude local overrides
*.local

# Agent dev-loop logs — local only, never committed
/logs/

# OS
.DS_Store
Thumbs.db

